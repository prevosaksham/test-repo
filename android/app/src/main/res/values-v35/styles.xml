<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 (API 35) forces edge-to-edge, which makes the uCrop toolbar
         draw UNDER the status bar (title/X overlap the clock on notch/curved
         phones). Opting out restores the system insetting the toolbar below the
         status bar. Only applied on API 35+. -->
    <style name="Theme.App.UCrop" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">#EA4313</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
